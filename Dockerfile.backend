FROM python:3.12-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY pyproject.toml uv.lock ./

# 安装 uv 和依赖
RUN pip install --no-cache-dir uv
RUN uv sync --no-dev

# 复制项目文件
COPY . .

# 暴露端口
EXPOSE 8000

# 启动 FastAPI（进入 app/ 目录，确保相对导入正常工作）
CMD ["sh", "-c", "cd /app/app && uv run --project /app uvicorn main:app --host 0.0.0.0 --port 8000"]